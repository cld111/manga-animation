# --- Environment / secrets ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- ML model weights & caches (never commit large binaries) ---
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.bin
*.h5
*.pb
*.tflite
*.gguf
*.msgpackb
models/weights/
checkpoints/
.cache/
.huggingface/
huggingface_cache/
torch_cache/
.torch/
.cuda_cache/
xdg_cache/

# --- Generated media / experiment outputs ---
# Directories are un-ignored one level at a time so git will traverse into them and find
# the .gitkeep placeholders below; their actual (generated) contents stay ignored via the
# per-directory `/*` rules and the extension rules further down.
outputs/*
!outputs/.gitkeep
!outputs/experiments/
!outputs/videos/
!outputs/frames/
!outputs/debug/
outputs/experiments/*
outputs/videos/*
outputs/frames/*
outputs/debug/*
!outputs/experiments/.gitkeep
!outputs/videos/.gitkeep
!outputs/frames/.gitkeep
!outputs/debug/.gitkeep
*.mp4
*.mov
*.avi
*.webm
*.gif
*.png.tmp

# --- Sample manga pages (copyrighted third-party content, fetched on demand) ---
# See scripts/fetch_sample_pages.py; never commit fetched pages, just the fetch script.
examples/*.png
examples/*.jpg
examples/*.jpeg
examples/*.webp

# --- Kaggle / Jupyter remote artifacts ---
kaggle.json
.kaggle/
*.kaggle-metadata
kaggle_working/

# --- OS / editor cruft ---
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# --- Claude Code: personal/local overrides, not shared config ---
.claude/settings.local.json

# --- Logs ---
*.log
logs/
